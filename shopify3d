document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('addToCartBtn');
    if (!btn) return;

    btn.addEventListener('click', async () => {
        // Dispara efeito 3D
        if (window.triggerHeartExplosion) window.triggerHeartExplosion();

        // Animação visual no botão
        btn.style.transform = 'scale(0.95)';
        setTimeout(() => { btn.style.transform = ''; }, 150);

        // Variáveis Shopify (substitua pelos valores corretos do seu tema)
        const variantId = 12345678901234; // ID da variante do produto
        const quantity = 1;

        // Usa a API do Shopify via AJAX (mesmo domínio)
        try {
            const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: variantId, quantity: quantity })
            });
            const data = await response.json();
            if (response.ok) {
                // Feedback de sucesso
                showNotification('💖 Adicionado ao carrinho com amor 3D! 💖');
                // Atualiza contador do carrinho (opcional)
                updateCartCount();
            } else {
                throw new Error(data.description || 'Erro ao adicionar');
            }
        } catch (err) {
            console.error('ByBot detectou falha:', err);
            showNotification('❌ Falha na adição, mas o amor 3D continua... Recarregue?', true);
        }
    });
});

function showNotification(msg, isError = false) {
    const notif = document.createElement('div');
    notif.innerText = msg;
    notif.style.position = 'fixed';
    notif.style.bottom = '20px';
    notif.style.left = '50%';
    notif.style.transform = 'translateX(-50%)';
    notif.style.backgroundColor = isError ? '#aa3333' : '#33aa66';
    notif.style.color = 'white';
    notif.style.padding = '12px 24px';
    notif.style.borderRadius = '50px';
    notif.style.fontWeight = 'bold';
    notif.style.zIndex = '1000';
    notif.style.backdropFilter = 'blur(8px)';
    notif.style.fontFamily = 'monospace';
    document.body.appendChild(notif);
    setTimeout(() => notif.remove(), 3000);
}

async function updateCartCount() {
    try {
        const resp = await fetch('/cart.js');
        const cart = await resp.json();
        const count = cart.item_count || 0;
        // Atualiza algum elemento no header ou footer
        let counterEl = document.getElementById('cart-count');
        if (!counterEl) {
            counterEl = document.createElement('span');
            counterEl.id = 'cart-count';
            counterEl.style.marginLeft = '10px';
            counterEl.style.background = '#ff3366';
            counterEl.style.padding = '2px 8px';
            counterEl.style.borderRadius = '50px';
            document.querySelector('header').appendChild(counterEl);
        }
        counterEl.innerText = `🛒 ${count}`;
    } catch(e) { console.warn('Erro ao pegar carrinho'); }
}
